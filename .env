DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here-change-this-in-production
DATABASE_URL=postgresql://saasflow_user:saasflow_password@db:5432/saasflow

# PostgreSQL settings (for Django's settings.py)
POSTGRES_DB=saasflow
POSTGRES_USER=saasflow_user
POSTGRES_PASSWORD=saasflow_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Stripe Configuration
